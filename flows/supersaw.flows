# Supersaw: a trance lead built from a stack of detuned saws.
import standard as std
from lib.osc import ClassicSaw, ClassicSine
from lib.filt import ClassicFilt
from lib.env import ClassicADSR

class Brightness(ClassicFilt):
    def init:
        self.register_knob(
            cutoff, default=3.2khz, range=(200hz, 14khz),
            step=10hz, scale=log, update=live
        )
        self.register_knob(
            resonance, default=0.25, range=(0, 0.85), step=0.01
        )

Inst.sigstream(std.event.keys.poly()) as key:
    stack = ClassicSaw.make()
    body = ClassicSine.make()
    filt = Brightness.make()
    env = ClassicADSR.make()

    saws = stack(
        pitch: key.pitch, level: -17db,
        unison: 7, detune: 22, spread: 1, random: 0.8
    )
    sub = body(pitch: key.pitch, octave: -1, level: -14db)
    tone = filt(
        saws + sub, mode: lowpass, cutoff: 3.2khz, resonance: 0.25
    )
    amp = env(
        gate: key.gate, trigger: key.trigger,
        retrigger_from: current,
        A: 6ms, D: 380ms, S: 0.65, R: 520ms
    )
    return tone * amp * key.velocity
